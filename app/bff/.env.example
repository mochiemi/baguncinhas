# ---------------------------------------------------------------------------
# Copie este arquivo para `.env` e preencha. O `.env` NUNCA vai para o Git.
# ---------------------------------------------------------------------------

# Obrigatória. Google Cloud Console > APIs e serviços > Credenciais > Chave de API.
# Habilite antes a "Blogger API v3" na biblioteca de APIs do projeto.
BLOGGER_API_KEY=

# Endereço do blog. É com isso que descobrimos o ID numérico na primeira
# chamada, e é o domínio usado para reescrever os links internos dos posts.
BLOGGER_BLOG_URL=https://mochiblog.blogspot.com

# Opcional. Se você já sabe o ID numérico do blog, coloque aqui: economiza uma
# chamada na inicialização. Dá para descobrir com:
#   curl "https://www.googleapis.com/blogger/v3/blogs/byurl?url=SEU_BLOG&key=SUA_CHAVE"
BLOGGER_BLOG_ID=

# Origem do site final. Serve para reescrever links que apontam para o
# blogspot.com e levá-los de volta para dentro do site.
SITE_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# Ajustes finos. Os valores padrão servem bem para começar.
# ---------------------------------------------------------------------------

PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# Por quanto tempo o índice de posts é considerado fresco. Passado esse tempo,
# a próxima visita recebe a versão antiga e o BFF atualiza em segundo plano.
INDEX_TTL_MS=900000

# Teto de espera por resposta do Blogger, por requisição.
UPSTREAM_TIMEOUT_MS=8000

DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=50

# Normalmente NÃO precisa. O front fala com este BFF através de um proxy
# same-origin, então não existe requisição cross-origin para autorizar.
# Preencha só se algum cliente for chamar a API de outro domínio.
CORS_ORIGINS=

# ---------------------------------------------------------------------------
# Painel de escrita
# ---------------------------------------------------------------------------
# As três abaixo são opcionais, mas formam um conjunto: ou as três estão
# preenchidas, ou nenhuma. Enquanto estiverem vazias, o BFF NÃO registra as
# rotas de login nem as de escrita. O site continua funcionando como leitura.
#
# Nome de usuário usado para entrar no painel. É só um nome: NÃO precisa ser um
# endereço de e-mail, e não tem relação com nenhuma conta do Google.
# Não use `USER`, que já existe no sistema em Linux e macOS.
ADMIN_USER=

# Hash da senha, NUNCA a senha. Gere com:
#   pnpm --filter @mochiblog/bff hash:password
# e cole a saída inteira aqui. O formato é scrypt$sal$hash.
ADMIN_PASSWORD_HASH=

# Segredo para assinar e criptografar o cookie de sessão.
# Mínimo de 32 caracteres, aleatório. Ninguém digita isso; não precisa memorizar.
# Para gerar um: qualquer gerador de senha, ou dois GUIDs colados.
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Permissão de ESCRITA no Blogger
# ---------------------------------------------------------------------------
# Estas três são independentes das de cima. O login acima diz QUEM entra no
# painel; estas dizem se o serviço consegue ESCREVER no Blogger.
#
# Enquanto estiverem vazias, as rotas de escrita respondem 503 dizendo o que
# falta. Instruções passo a passo no README, seção "Permissão de escrita".
#
# Escrever exige OAuth 2.0: a API key acima só lê. Estes valores vêm de uma
# autorização feita UMA vez, e ficam parados no servidor.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

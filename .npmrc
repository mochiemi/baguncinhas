# O pnpm cria um node_modules "estrito", onde cada pacote só enxerga as próprias
# dependências. É ótimo contra dependência fantasma, mas algumas ferramentas do
# ecossistema (Nuxt, builders de serverless) assumem que conseguem importar
# qualquer coisa de dentro do node_modules. `shamefully-hoist` achata a árvore.
#
# Se um dia o Nuxt reclamar de pacote não encontrado, é daqui que vem a solução.
# O nome é feio de propósito: o pnpm quer que você saiba que está abrindo mão de
# uma garantia.
shamefully-hoist=true

# Garante que a instalação falhe em vez de "quase funcionar" quando alguém usar
# uma versão diferente do pnpm.
engine-strict=true
